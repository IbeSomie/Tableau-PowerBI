              <calculation class='tableau' formula='([MTD Loan Applications (copy)_1085006242570243] - [MTD Total Funded Amount (copy)_1085006244765700])&#13;&#10;/&#13;&#10;[MTD Total Funded Amount (copy)_1085006244765700]' />
